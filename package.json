    "tree-sitter-typescript": "0.21.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
