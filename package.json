    "extract": "tsx src/graph/testContextExtractor.ts",
    "dependencies": "tsx src/graph/testDependencyBuilder.ts",
    "generate": "tsx src/graph/testContextGenerator.ts",
    "analyze": "tsx src/graph/testQueryAnalyzer.ts",
